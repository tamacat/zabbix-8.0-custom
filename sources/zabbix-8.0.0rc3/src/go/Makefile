	CGO_CFLAGS="${CGO_CFLAGS}" CGO_LDFLAGS="${CGO_LDFLAGS}" \
		$(GO) build \
		-tags="${AGENT_GOTAGS}" \
		-ldflags="${AGENT_GOLDFLAGS}" \
		-o bin \
		golang.zabbix.com/agent2/cmd/zabbix_agent2

